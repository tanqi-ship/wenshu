# ---------------------------------------------------------------------------
# 运行环境
# ---------------------------------------------------------------------------
WENSHU_ENV=local

# ---------------------------------------------------------------------------
# 应用库（元数据 / 语义层 / 评测结果）
# ---------------------------------------------------------------------------
WENSHU_DATABASE_URL=postgresql+psycopg://wenshu:wenshu@localhost:5433/wenshu

# ---------------------------------------------------------------------------
# 目标业务库（被问数的库）
# 开发期用 Postgres 模拟；生产是 Oracle
# ---------------------------------------------------------------------------
WENSHU_FIXTURE_URL=postgresql+psycopg://bankfixture:bankfixture@localhost:5434/bankfixture

# ---------------------------------------------------------------------------
# 模型访问
#
#   WENSHU_LLM_MODE 决定用哪个 LLMClient 实现：
#     fake    —— 单元测试：按脚本返回，零网络
#     replay  —— CI/回归：回放 cassette，零网络
#     real    —— 本地/生产：真实调用
#
# 铁律：CI 里必须是 replay 或 fake。留空不行。
# ---------------------------------------------------------------------------
WENSHU_LLM_MODE=fake

# 回放模式
WENSHU_LLM_CASSETTE_DIR=tests/cassettes
# 1 = 找不到 cassette 直接报错（防止 CI 悄悄退化成真实调用）
WENSHU_LLM_STRICT_REPLAY=1

# 真实模式（OpenAI 兼容接口）
WENSHU_LLM_BASE_URL=https://api.deepseek.com/v1
WENSHU_LLM_API_KEY=
WENSHU_LLM_MODEL=deepseek-chat
WENSHU_LLM_TIMEOUT_S=120

# 向量化（语义层检索）
# fake 模式下使用确定性哈希向量，保证测试可复现
WENSHU_EMBED_MODE=fake
WENSHU_EMBED_DIM=256
WENSHU_EMBED_BASE_URL=
WENSHU_EMBED_API_KEY=
WENSHU_EMBED_MODEL=

# ---------------------------------------------------------------------------
# 查询执行
# ---------------------------------------------------------------------------
WENSHU_SQL_TIMEOUT_S=30
WENSHU_ROW_LIMIT=1000
WENSHU_EXPLAIN_ENABLED=true

# ---------------------------------------------------------------------------
# 澄清预算：一次提问最多问几轮。防止追问泛滥。
# ---------------------------------------------------------------------------
WENSHU_MAX_CLARIFY_ROUNDS=2
